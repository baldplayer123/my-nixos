include /etc/sway/config.d/*

## Variables
set $mod Mod4
set $term kitty
set $menu wofi --show drun
set $browser firefox

input "type:keyboard" {
	xkb_layout "fr"
    xkb_options "caps:escape"
}

input "type:touchpad" {
	tap enabled
	natural_scroll enabled
}

## AutoStart
exec waybar
exec mako
exec swayidle -w timeout 300 'swaylock -f'
exec swaybg -i ~/.config/sway/wallpaper.jpg -m fill  

## Appearance
gaps inner 5
gaps outer 5
default_border pixel 2

## Core keybinds
bindsym $mod+t exec $term
bindsym $mod+q kill
bindsym $mod+a exec $menu
bindsym $mod+v floating toggle
bindsym $mod+Shift+b fullscreen
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit
bindsym $mod+Shift+f exec $browser
bindsym $mod+Escape exec swaylock -f
bindsym $mod+o exec obsidian
bindsym $mod+d exec swaymsg [app_id="discord-ptb"] focus || discord-ptb


## Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

## Move window - 
bindsym $mod+Shift+h focus left
bindsym $mod+Shift+j focus down
bindsym $mod+Shift+k focus up
bindsym $mod+Shift+l focus right

## Splits
bindsym $mod+b splith
bindsym $mod+n splitv

### Workspaces — AZERTY top row
bindsym $mod+ampersand workspace 1
bindsym $mod+eacute workspace 2
bindsym $mod+quotedbl workspace 3
bindsym $mod+apostrophe workspace 4
bindsym $mod+parenleft workspace 5
bindsym $mod+minus workspace 6
bindsym $mod+egrave workspace 7
bindsym $mod+underscore workspace 8
bindsym $mod+ccedilla workspace 9
bindsym $mod+agrave workspace 10

### Move focused window to workspace — AZERTY top row
bindsym $mod+Shift+ampersand move container to workspace 1
bindsym $mod+Shift+eacute move container to workspace 2
bindsym $mod+Shift+quotedbl move container to workspace 3
bindsym $mod+Shift+apostrophe move container to workspace 4
bindsym $mod+Shift+parenleft move container to workspace 5
bindsym $mod+Shift+minus move container to workspace 6
bindsym $mod+Shift+egrave move container to workspace 7
bindsym $mod+Shift+underscore move container to workspace 8
bindsym $mod+Shift+ccedilla move container to workspace 9
bindsym $mod+Shift+agrave move container to workspace 10


### Resize mode
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 30px
    bindsym j resize grow height 30px
    bindsym k resize shrink height 30px
    bindsym l resize grow width 30px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### Media keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

### Screenshots
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+p exec grim - | wl-copy

# ── Window border colors (minimal black/mono) ──────────
# client.<class>      <border>  <background> <text>    <indicator> <child_border>
client.focused          #ffffff   #ffffff      #0a0a0a   #ffffff     #ffffff
client.focused_inactive #161616   #161616      #cfcfcf   #161616     #161616
client.unfocused        #0a0a0a   #0a0a0a      #777777   #0a0a0a     #0a0a0a
client.urgent           #c05050   #c05050      #0a0a0a   #c05050     #c05050

