## Variables
set $mod Mod4
set $term kitty
set $menu wofi --show drun
set $browser firefox

input "type:keyboard" {
	xkb_layout "fr"
}

input "type:touchpad" {
	tap enabled
	natural_scroll enabled
}

## AutoStart
exec waybar
exec mako
#exec swaybg -i ~/.config/sway/wallpaper.jpg -m fill

## Appearance
gaps inner 5
gaps outer 5
default_border pixel 2

## Core keybinds
bindsym $mod+t exec $term
bindsym $mod+q kill
bindsym $mod+a $menu
bindsym $mod+v floating toggle
bindsym $mod+Shift+b fullscreen
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit
bindsym $mod+Shift+f exec $browser

## Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

## Move window - 
bindsym $mod+Shift+h focus left
bindsym $mod+Shift+j focus down
bindsym $mod+Shift+k focus up
bindsym $mod+Shift+l focus right

## Splits
bindsym $mod+b splith
bindsym $mod+n splitv

### Workspaces — AZERTY top row
bindsym $mod+ampersand workspace 1
bindsym $mod+eacute workspace 2
bindsym $mod+quotedbl workspace 3
bindsym $mod+apostrophe workspace 4
bindsym $mod+parenleft workspace 5
bindsym $mod+minus workspace 6
bindsym $mod+egrave workspace 7
bindsym $mod+underscore workspace 8
bindsym $mod+ccedilla workspace 9
bindsym $mod+agrave workspace 10


### Resize mode
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 30px
    bindsym j resize grow height 30px
    bindsym k resize shrink height 30px
    bindsym l resize grow width 30px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### Media keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

### Screenshots
bindsym $mod+p exec env XDG_CURRENT_DESKTOP=sway flameshot screen -c
